{
  "compilerOptions": {
    "target": "ES2018",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "ES2018"],
    "allowJs": true,
    // phonetics.js размечен JSDoc'ом — проверяем и его, иначе разметка со временем соврёт
    "checkJs": true,
    "strict": false,
    // включено отдельно от strict: именно неявные any кормят правила no-unsafe-* у
    // линтера каталога. strictNullChecks — отдельная большая работа, пока не он
    "noImplicitAny": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["src/**/*"]
}
